# Copy to .env.local and fill in (never commit .env.local)

# --- AI agents (Extra + School) ---
# Without any key, Extra and School use the local demo banks/replies.
# School still picks grade-matched questions without a key.

# Default provider: Z.ai (free GLM Flash models, OpenAI-compatible API)
# Get a key at https://z.ai/manage-apikey/apikeys
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-flash
# Other free options: glm-4.7-flash
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# "enabled" turns on GLM reasoning (slower, not needed for kids chat)
# ZAI_THINKING=disabled

# Optional alternative: OpenAI (used when no ZAI_API_KEY, or with AI_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Force a provider (zai | openai). Default: Z.ai if its key is set, else OpenAI.
# AI_PROVIDER=zai

# Request timeout for agent calls, in ms (default 12000)
# AI_TIMEOUT_MS=12000

# --- Voice (text-to-speech) ---
# Engine order on the client: kokoro (default) | azure | browser
#   kokoro  = free Kokoro 82M voice running IN THE BROWSER (no key; ~80 MB model
#             downloaded once from huggingface.co and cached). Browser voice speaks
#             while it loads.
#   azure   = server route /api/tts with Azure Speech neural voices (needs the keys below)
#   browser = Web Speech API only (best installed voice)
NEXT_PUBLIC_TTS_ENGINE=kokoro
# Kokoro voice id (af_heart is the highest rated; also af_bella, af_nicole, bf_emma...)
# NEXT_PUBLIC_KOKORO_VOICE=af_heart

# Prepared for the demo: Azure Speech (free F0 tier). Used when NEXT_PUBLIC_TTS_ENGINE=azure.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=uaenorth
# AZURE_SPEECH_VOICE=en-US-AnaNeural
# AZURE_SPEECH_RATE=-5%

# --- App ---
# Public site URL if you deploy (optional for local)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
