# Copy to .env.local and fill in (never commit .env.local)

# --- AI agents (Extra + School) ---
# Without any key, Extra and School use the local demo banks/replies.
# School still picks grade-matched questions without a key.

# Default provider: Z.ai (free GLM Flash models, OpenAI-compatible API)
# Get a key at https://z.ai/manage-apikey/apikeys
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-flash
# Other free options: glm-4.7-flash
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# "enabled" turns on GLM reasoning (slower, not needed for kids chat)
# ZAI_THINKING=disabled

# Optional alternative: OpenAI (used when no ZAI_API_KEY, or with AI_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Force a provider (zai | openai). Default: Z.ai if its key is set, else OpenAI.
# AI_PROVIDER=zai

# Request timeout for agent calls, in ms (default 12000; Extra chat uses 15000)
# AI_TIMEOUT_MS=12000

# Max AI requests at the same time from this server (default 1 on Z.ai free tier, 4 on OpenAI)
# AI_MAX_CONCURRENCY=1

# --- Voice (text-to-speech) ---
# Client order (NEXT_PUBLIC_TTS_ENGINE):
#   kokoro  = Kokoro (EN, in-browser) → /api/tts → browser  [default]
#   azure   = /api/tts first → Kokoro → browser  (name is historical)
#   browser = Web Speech only
# NEXT_PUBLIC_TTS_ENGINE=kokoro
# NEXT_PUBLIC_KOKORO_VOICE=af_heart
# NEXT_PUBLIC_KOKORO_ON_MOBILE=1

# Preferred server TTS: ElevenLabs (EN + Arabic, phones). Get a key:
#   1. https://elevenlabs.io → Sign up / Log in
#   2. Profile menu (bottom-left) → API Keys → Create key
#   3. Paste below (and in Vercel → Environment Variables for Production)
# Starter (~$6/mo) is enough for a demo; Free has no commercial license.
ELEVENLABS_API_KEY=
# Voice IDs from https://elevenlabs.io/app/voice-library (copy Voice ID)
ELEVENLABS_VOICE_ID=piI8Kku0DcvcL6TTSeQt
ELEVENLABS_VOICE_ID_AR=KxMRrXEjbJ6kZ93yT3fq
# eleven_flash_v2_5 = cheaper + Arabic; eleven_multilingual_v2 = higher quality
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Optional Azure fallback (if ElevenLabs is unset):
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=uaenorth
# AZURE_SPEECH_VOICE=en-US-JennyNeural
# AZURE_SPEECH_VOICE_AR=ar-AE-FatimaNeural
# AZURE_SPEECH_RATE=-5%

# --- App ---
# Public site URL if you deploy (optional for local)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
