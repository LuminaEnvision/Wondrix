# Copy to .env.local and fill in (never commit .env.local)

# --- Extra + School agents (real AI coach notes / explanations) ---
# Without OPENAI_API_KEY, both Extra and School use local demo banks/replies.
# School still picks grade-matched questions without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: slower/cheaper models also work, e.g. gpt-4o-mini | gpt-4.1-mini
# OPENAI_MODEL=gpt-4o-mini

# Optional: point the agents at an OpenAI-compatible endpoint (proxy, mock, Azure gateway)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- App ---
# Public site URL if you deploy (optional for local)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
